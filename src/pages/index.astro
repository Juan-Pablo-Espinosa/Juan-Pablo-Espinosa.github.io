---
import Base from '../layouts/Base.astro';
import SectionLabel from '../components/SectionLabel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HeroSchematic from '../components/HeroSchematic.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { publicFileExists } from '../lib/assets';
import {
  getProjects,
  getNews,
  getResearchGroups,
  getPublications,
  getPatents,
  fmtDay,
  iso,
} from '../lib/content';

const [allProjects, news, groups, pubs, patents] = await Promise.all([
  getProjects(),
  getNews(),
  getResearchGroups(),
  getPublications(),
  getPatents(),
]);

// Derive featured from the same array so card numbers (P-01…) match /projects.
const featured = allProjects.filter((p) => p.data.featured);
const hasVideo = publicFileExists(site.heroVideo);
const hasPoster = publicFileExists(site.heroPoster);
const latestNews = news.slice(0, 4);
const hasResearch = groups.length + pubs.length + patents.length > 0;

// Sections render only when they have content; numbering follows what's shown.
const shown = {
  projects: featured.length > 0,
  research: hasResearch,
  news: latestNews.length > 0,
  contact: true,
};
const order = (Object.keys(shown) as (keyof typeof shown)[]).filter((k) => shown[k]);
const idx = (k: keyof typeof shown) => order.indexOf(k) + 1;

const countBy = <T extends string>(xs: T[]) =>
  Object.entries(
    xs.reduce<Record<string, number>>((acc, x) => ((acc[x] = (acc[x] ?? 0) + 1), acc), {}),
  );
---

<Base boot>
  <!-- ===== HERO ===== -->
  <section class="hero container" aria-labelledby="hero-name">
    <div class="hero-text">
      <p class="meta prompt"><span class="accent">&gt;</span> whoami</p>
      <h1 id="hero-name">{site.name}</h1>
      <p class="lead">{site.identity}</p>
      <dl class="readouts">
        <div><dt>ROLE</dt><dd>Founder · Daedamorph Robotics</dd></div>
        <div><dt>BUILD</dt><dd>GR0X morphing humanoid</dd></div>
        <div><dt>LAB</dt><dd>ALMaS Research Group · WPI</dd></div>
      </dl>
      <div class="btn-row">
        {
          allProjects.length > 0 && (
            <a class="btn btn-primary" href="/projects/">
              Projects <span class="arrow"><Icon name="arrow" size={14} /></span>
            </a>
          )
        }
        <a class="btn" href="/cv/"><Icon name="file" size={14} /> CV</a>
        <a class="btn" href="#contact"><Icon name="mail" size={14} /> Contact</a>
      </div>
    </div>

    <figure class="feed frame">
      <figcaption class="feed-bar meta">
        <span><span class="rec" aria-hidden="true"></span>{hasVideo ? 'CAM-01 · LIVE LOOP' : 'CAM-01 · SCHEMATIC'}</span>
        <span>GR0X</span>
      </figcaption>
      <div class="feed-view">
        {
          hasVideo ? (
            <video
              data-hero-video
              src={site.heroVideo}
              poster={hasPoster ? site.heroPoster : undefined}
              muted
              loop
              playsinline
              preload="none"
              aria-label="GR0X humanoid robot, looping clip"
            />
          ) : (
            <HeroSchematic />
          )
        }
      </div>
    </figure>
  </section>

  <!-- ===== FEATURED PROJECTS ===== -->
  {
    shown.projects && (
      <section class="section container" aria-labelledby="sec-projects">
        <SectionLabel index={idx('projects')} label="Featured Projects" title="Selected work" id="sec-projects" />
        <div class="grid-cards">
          {featured.slice(0, 3).map((p) => (
            <ProjectCard project={p} n={allProjects.indexOf(p) + 1} />
          ))}
        </div>
        {allProjects.length > featured.slice(0, 3).length && (
          <p class="more">
            <a class="btn" href="/projects/">
              All projects ({allProjects.length}) <span class="arrow"><Icon name="arrow" size={14} /></span>
            </a>
          </p>
        )}
      </section>
    )
  }

  <!-- ===== RESEARCH SNIPPET ===== -->
  {
    shown.research && (
      <section class="section container" aria-labelledby="sec-research">
        <SectionLabel index={idx('research')} label="Research" title="Research & IP" id="sec-research" />
        <div class="research-grid">
          {groups.map((g) => (
            <div class="frame research-card" data-reveal>
              <p class="meta">{g.data.institution}</p>
              <h3>{g.data.name}</h3>
              <p class="dim">
                {g.data.role}
                {g.data.advisor && <> · {g.data.advisor}</>}
              </p>
            </div>
          ))}
          <div class="frame research-card telemetry" data-reveal>
            <p class="meta">// OUTPUT</p>
            <ul>
              {countBy(patents.map((p) => p.data.type)).map(([type, n]) => (
                <li>
                  <span class="accent">{String(n).padStart(2, '0')}</span> {type} patent{n > 1 ? 's' : ''}
                </li>
              ))}
              {countBy(pubs.map((p) => p.data.status)).map(([status, n]) => (
                <li>
                  <span class="accent">{String(n).padStart(2, '0')}</span> {status.replace('-', ' ')}{' '}
                  {n > 1 ? 'publications' : 'publication'}
                </li>
              ))}
            </ul>
            <a class="btn" href="/research/">
              Research <span class="arrow"><Icon name="arrow" size={14} /></span>
            </a>
          </div>
        </div>
      </section>
    )
  }

  <!-- ===== NEWS ===== -->
  {
    shown.news && (
      <section class="section container" aria-labelledby="sec-news">
        <SectionLabel index={idx('news')} label="Latest" title="News" id="sec-news" />
        <ol class="news" data-reveal>
          {latestNews.map((n) => (
            <li>
              <time class="meta" datetime={iso(n.data.date)}>
                {fmtDay(n.data.date)}
              </time>
              <span>{n.data.link ? <a href={n.data.link}>{n.data.text}</a> : n.data.text}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <!-- ===== CONTACT ===== -->
  <section id="contact" class="section container" aria-labelledby="sec-contact">
    <SectionLabel index={idx('contact')} label="Contact" title="Open a channel" id="sec-contact" />
    <div class="contact frame" data-reveal>
      <div>
        <p class="dim">
          Internships, research collaborations, or questions about GR0X — I'd like to hear from you.
        </p>
      </div>
      <ContactLinks />
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(3rem, 8vw, 6rem) clamp(1rem, 3vw, 2rem);
  }
  .prompt {
    margin-bottom: 1rem;
    text-transform: none;
    font-size: 0.85rem;
  }
  .hero .lead {
    margin-top: 1.1rem;
  }
  .readouts {
    display: grid;
    gap: 0.35rem;
    margin: 1.75rem 0 2rem;
    padding: 0.9rem 1rem;
    border-left: 1px solid var(--accent-line);
    background: linear-gradient(90deg, var(--accent-soft), transparent 70%);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .readouts div {
    display: flex;
    gap: 1rem;
  }
  .readouts dt {
    width: 4.5rem;
    flex: none;
    color: var(--text-faint);
    letter-spacing: 0.1em;
  }
  .readouts dd {
    margin: 0;
    color: var(--text);
  }
  .feed {
    margin: 0;
    background-color: var(--bg-inset);
  }
  .feed-bar {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.66rem;
  }
  .rec {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
    vertical-align: 1px;
  }
  .feed-view {
    aspect-ratio: 4 / 4.2;
    display: grid;
    place-items: center;
    padding: 1rem;
  }
  .feed-view video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Cards grid */
  .grid-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
  }
  .more {
    margin-top: 2rem;
  }

  /* Research */
  .research-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .research-card {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .telemetry ul {
    list-style: none;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: capitalize;
    display: grid;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
  }
  .telemetry .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  /* News */
  .news {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .news li {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .news a {
    color: var(--text);
    text-underline-offset: 3px;
  }
  .news a:hover {
    color: var(--accent);
  }

  /* Contact */
  .contact {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .contact p {
    max-width: 48ch;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .feed-view {
      aspect-ratio: 4 / 3.4;
    }
  }
  @media (max-width: 520px) {
    .news li {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
  }
</style>

<script>
  // Hero loop: only autoplay when motion is allowed; otherwise show the poster.
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    v.preload = 'auto';
    v.play().catch(() => {});
  }
</script>

---
/** Themed 404. GitHub Pages serves /404.html for any unknown path. */
import Base from '../layouts/Base.astro';
import { getProjects } from '../lib/content';

const hasProjects = (await getProjects()).length > 0;
---

<Base title="404 — Route not found" description="This page does not exist." noindex>
  <section class="container wrap">
    <div class="term frame">
      <p class="meta bar"><span>tty1 · GR0X-OS</span><span class="accent">ERR 404</span></p>
      <pre class="log" aria-hidden="true"><span class="fail">[FAILED]</span> Failed to start route.service - Requested path.
<span class="dim">         See 'journalctl -xeu route.service' for details.</span>
<span class="ok">[  OK  ]</span> Fallback target reached: home.</pre>
      <h1>Route not found</h1>
      <p class="dim">The page you're looking for doesn't exist or has moved.</p>
      <div class="btn-row">
        <a class="btn btn-primary" href="/">Return to home</a>
        {hasProjects && <a class="btn" href="/projects/">Browse projects</a>}
      </div>
    </div>
  </section>
</Base>

<style>
  .wrap {
    padding-block: clamp(3rem, 12vw, 8rem);
  }
  .term {
    max-width: 760px;
    margin-inline: auto;
    padding: 0 clamp(1.25rem, 4vw, 2rem) clamp(1.5rem, 4vw, 2rem);
    background-color: var(--bg-inset);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    margin-inline: calc(-1 * clamp(1.25rem, 4vw, 2rem));
    padding: 0.6rem clamp(1.25rem, 4vw, 2rem);
    border-bottom: 1px solid var(--line);
    margin-bottom: 1.5rem;
  }
  .log {
    font-family: var(--font-mono);
    font-size: clamp(0.7rem, 1.8vw, 0.85rem);
    white-space: pre-wrap;
    color: var(--text-dim);
    margin-bottom: 2rem;
  }
  .fail {
    color: #ff6b5a;
  }
  .ok {
    color: var(--accent);
  }
  h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }
  .term > p.dim {
    margin: 0.6rem 0 1.75rem;
  }
</style>

---
/**
 * CV page. Put your PDF at `public/cv/Juan-Pablo-Espinosa-CV.pdf`
 * (path configurable in site.config.ts), then run `npm run cv:preview` to
 * regenerate the page images in src/assets/cv/.
 *
 * The resume is shown as optimized images rather than an embedded PDF viewer:
 * in-page PDF viewers are blank on Android Chrome and in browsers set to
 * download PDFs. Each page links to the real PDF.
 * Until a PDF exists, a fallback panel is shown instead.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactLinks from '../components/ContactLinks.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site.config';
import { publicFileExists } from '../lib/assets';

const hasPdf = publicFileExists(site.resumePath);

// Page images generated by `npm run cv:preview` (page-1.png, page-2.png, …).
const pageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/cv/page-*.png', { eager: true });
const pages = Object.entries(pageModules)
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, m]) => m.default);
---

<Base title="CV" description={`Curriculum vitae of ${site.name}, robotics engineering student at WPI.`}>
  <PageHeader label="CURRICULUM VITAE" title="CV">
    {
      hasPdf && (
        <div class="btn-row actions">
          <a class="btn btn-primary" href={site.resumePath} download>
            <Icon name="download" size={14} /> Download PDF
          </a>
          <a class="btn" href={site.resumePath} target="_blank" rel="noopener">
            <Icon name="external" size={14} /> Open in new tab
          </a>
        </div>
      )
    }
  </PageHeader>

  <section class="container">
    {
      hasPdf ? (
        <div class="viewer">
          {pages.length > 0 ? (
            pages.map((page, i) => (
              <a class="page frame" href={site.resumePath} target="_blank" rel="noopener">
                <Image
                  src={page}
                  alt={`${site.name} — resume, page ${i + 1} of ${pages.length}. Opens the PDF.`}
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 900px) 860px, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : undefined}
                />
              </a>
            ))
          ) : (
            <p class="dim">
              Preview not generated yet — use the buttons above to open the PDF.
            </p>
          )}
          <p class="meta hint">Click the page to open the full PDF</p>
        </div>
      ) : (
        <div class="missing frame">
          <p class="meta accent">// DOCUMENT STATUS: UPDATING</p>
          <h2>The latest CV is being revised</h2>
          <p class="dim">In the meantime, reach out and I'll send the current version directly.</p>
          <ContactLinks />
        </div>
      )
    }
  </section>
</Base>

<style>
  .actions {
    margin-top: 1.5rem;
  }
  .viewer {
    display: grid;
    gap: 1.25rem;
    justify-items: center;
  }
  .page {
    display: block;
    width: 100%;
    max-width: 860px;
    padding: 6px;
  }
  .page:hover {
    --c: var(--accent);
  }
  .page :global(img) {
    width: 100%;
    height: auto;
    background: #fff;
  }
  .hint {
    text-align: center;
  }
  .missing {
    display: grid;
    gap: 1rem;
    padding: clamp(1.5rem, 5vw, 3rem);
    max-width: 720px;
  }
</style>

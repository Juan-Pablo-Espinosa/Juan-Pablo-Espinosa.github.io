---
/**
 * Base page shell: <head> SEO/Open Graph/Twitter tags, fonts, header,
 * footer, the optional boot overlay, and two tiny global scripts
 * (UTC clock + scroll reveal).
 */
// Latin-only font files keep CSS small (Inter's @font-face lives in global.css).
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/global.css';
import interLatin from '../assets/fonts/inter-latin-wght-normal.woff2?url';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BootSequence from '../components/BootSequence.astro';
import { site } from '../site.config';

interface Props {
  /** Page title; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Absolute path of the OG image for this page (defaults to the site card). */
  ogImage?: string;
  ogType?: 'website' | 'article' | 'profile';
  /** Show the boot sequence on this page (first visit per session only). */
  boot?: boolean;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  ogImage = '/og/site.png',
  ogType = 'website',
  boot = false,
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Robotics Engineer`;
// Canonical always uses the trailing-slash form that GitHub Pages serves.
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, Astro.site).href;
const ogUrl = new URL(ogImage, Astro.site).href;
const showBoot = boot && site.boot.enabled;

// JSON-LD: tells search engines this site is about a person.
const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: 'Research Lead, GR0X Humanoid',
  affiliation: { '@type': 'CollegeOrUniversity', name: 'Worcester Polytechnic Institute' },
  sameAs: [site.contact.github, site.contact.linkedin].filter(Boolean),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0a0b0d" />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

    <!--
      Runs before first paint: marks JS as available (enables scroll reveal) and
      decides whether to show the boot sequence. Any storage error → no boot.
    -->
    <script is:inline define:vars={{ showBoot }}>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (!showBoot) return;
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          if (sessionStorage.getItem('gr0x-booted')) return;
          sessionStorage.setItem('gr0x-booted', '1');
          d.classList.add('booting');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {showBoot && <BootSequence />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Live UTC clock for every [data-utc-clock] element.
      const clocks = document.querySelectorAll<HTMLTimeElement>('[data-utc-clock]');
      if (clocks.length) {
        const tick = () => {
          const now = new Date();
          const t = now.toISOString().slice(11, 19);
          clocks.forEach((c) => {
            c.textContent = t;
            c.dateTime = now.toISOString();
          });
        };
        tick();
        setInterval(tick, 1000);
      }

      // Scroll reveal: add .is-in once an element enters the viewport.
      const targets = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add('is-in'));
      }
    </script>
  </body>
</html>

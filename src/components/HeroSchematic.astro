---
/**
 * Line-art schematic of GR0X. The body rises while the prismatic lower legs
 * extend — a visual of the variable-length limbs. Animation is CSS-only and
 * disabled for prefers-reduced-motion.
 */
---

<svg class="schematic" viewBox="0 0 400 470" role="img" aria-labelledby="schem-title">
  <title id="schem-title">Schematic of the GR0X humanoid with telescoping prismatic legs</title>
  <g class="ground" stroke="currentColor" stroke-opacity=".35">
    <path d="M60 422H340"></path>
    <path d="M70 422l-8 8M90 422l-8 8M110 422l-8 8M130 422l-8 8M150 422l-8 8M170 422l-8 8M190 422l-8 8M210 422l-8 8M230 422l-8 8M250 422l-8 8M270 422l-8 8M290 422l-8 8M310 422l-8 8M330 422l-8 8"></path>
  </g>

  <!-- Inner prismatic rods: anchored at the feet, stretch as the body rises -->
  <g class="rods" fill="var(--accent-soft)" stroke="var(--accent)">
    <rect class="rod" x="179" y="380" width="10" height="40"></rect>
    <rect class="rod" x="211" y="380" width="10" height="40"></rect>
  </g>
  <!-- Feet -->
  <g fill="none" stroke="currentColor" stroke-opacity=".9">
    <path d="M172 420h28l6 2h-40z"></path>
    <path d="M204 420h28l6 2h-40z"></path>
  </g>

  <!-- Upper body moves as one group -->
  <g class="body" fill="none" stroke="currentColor" stroke-opacity=".9">
    <rect x="178" y="40" width="44" height="46" rx="3"></rect>
    <path d="M186 60h28" stroke="var(--accent)"></path>
    <path d="M200 86v12"></path>
    <path d="M160 100h80l-8 108h-64z"></path>
    <rect x="186" y="118" width="28" height="18" stroke-opacity=".5"></rect>
    <rect x="170" y="212" width="60" height="22"></rect>
    <!-- arms -->
    <circle cx="156" cy="108" r="6"></circle>
    <circle cx="244" cy="108" r="6"></circle>
    <path d="M153 113l-14 56M139 175l-4 52"></path>
    <path d="M247 113l14 56M261 175l4 52"></path>
    <circle cx="139" cy="172" r="4"></circle>
    <circle cx="261" cy="172" r="4"></circle>
    <!-- thighs -->
    <rect x="176" y="238" width="16" height="72"></rect>
    <rect x="208" y="238" width="16" height="72"></rect>
    <circle cx="184" cy="318" r="7"></circle>
    <circle cx="216" cy="318" r="7"></circle>
    <!-- lower-leg outer tubes -->
    <rect x="176" y="326" width="16" height="60"></rect>
    <rect x="208" y="326" width="16" height="60"></rect>
    <!-- CAN bus hint -->
    <path d="M200 136v76" stroke="var(--accent)" stroke-dasharray="2 4" stroke-opacity=".8"></path>
  </g>

  <!-- Dimension callout -->
  <g class="dim-line" stroke="currentColor" stroke-opacity=".45" fill="none">
    <path d="M250 236h60M250 422h60"></path>
    <path class="dim-v" d="M300 240v178"></path>
    <path d="M296 246l4-6 4 6M296 412l4 6 4-6"></path>
  </g>
  <g font-family="var(--font-mono)" font-size="11" fill="currentColor">
    <text x="312" y="324" fill-opacity=".9">L_LEG</text>
    <text x="312" y="340" fill="var(--accent)">710–1000</text>
    <text x="312" y="354" fill-opacity=".6">mm</text>
    <text x="60" y="30" fill-opacity=".55">GR0X // MORPH-A</text>
    <text x="60" y="455" fill-opacity=".55">PRISMATIC · PLANETARY LEAD-SCREW</text>
  </g>
</svg>

<style>
  .schematic {
    width: 100%;
    height: 100%;
    color: var(--text-dim);
    stroke-width: 1.25;
  }
  .rod {
    transform-box: fill-box;
    transform-origin: 50% 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .body {
      animation: rise 6s var(--ease) infinite alternate;
    }
    .rod {
      animation: extend 6s var(--ease) infinite alternate;
    }
  }
  @keyframes rise {
    0%,
    15% {
      transform: translateY(0);
    }
    85%,
    100% {
      transform: translateY(-30px);
    }
  }
  @keyframes extend {
    0%,
    15% {
      transform: scaleY(1);
    }
    85%,
    100% {
      transform: scaleY(1.75);
    }
  }
</style>

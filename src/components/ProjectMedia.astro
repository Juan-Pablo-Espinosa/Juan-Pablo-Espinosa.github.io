---
/**
 * Video for a case study: a self-hosted short loop (lazy, never autoloads)
 * or a YouTube link rendered as a click-to-load facade (no YouTube JS until
 * the visitor asks for it — keeps Lighthouse happy and protects privacy).
 */
import { youTubeId } from '../lib/content';

interface Props {
  src: string;
  title: string;
}
const { src, title } = Astro.props;
const yt = youTubeId(src);
---

{
  yt ? (
    <div class="yt frame" data-yt={yt}>
      <img src={`https://i.ytimg.com/vi/${yt}/hqdefault.jpg`} alt="" loading="lazy" width="480" height="360" />
      <button type="button" class="play" aria-label={`Play video: ${title}`}>
        <span aria-hidden="true">▶</span> PLAY FEED
      </button>
      <noscript>
        <a class="btn" href={`https://www.youtube.com/watch?v=${yt}`}>Watch on YouTube</a>
      </noscript>
    </div>
  ) : (
    <video class="vid frame" src={src} controls muted loop playsinline preload="none" aria-label={title} />
  )
}

<style>
  .vid,
  .yt {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--bg-inset);
    object-fit: cover;
  }
  .yt {
    position: relative;
    overflow: hidden;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.6;
  }
  .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .play {
    position: absolute;
    inset: 0;
    margin: auto;
    width: max-content;
    height: max-content;
    padding: 0.8rem 1.2rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    background: var(--bg);
    color: var(--accent);
    border: 1px solid var(--accent);
    cursor: pointer;
  }
  .play:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((box) => {
    box.querySelector('button')?.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = box.querySelector('button')?.getAttribute('aria-label') ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      box.replaceChildren(iframe);
    });
  });
</script>

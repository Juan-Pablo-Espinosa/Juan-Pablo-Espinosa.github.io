---
/** Top-of-page header for inner pages: `// PATH` label, H1, optional lead. */
interface Props {
  label: string;
  title: string;
  lead?: string;
}
const { label, title, lead } = Astro.props;
---

<header class="page-header container">
  <p class="section-label"><span class="idx" aria-hidden="true">//</span> {label}</p>
  <h1>{title}</h1>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem);
  }
  h1 {
    margin-top: 1rem;
  }
  .lead {
    margin-top: 1rem;
  }
</style>
